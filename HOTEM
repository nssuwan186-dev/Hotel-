# --- ROOM STATUS ---
async def check_room_status(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """แสดงสถานะห้องพักว่าง/ไม่ว่างทั้งหมด"""
    logger.debug(f"DEBUG: check_room_status called for user {update.effective_user.id}")
    query = update.callback_query
    await query.answer()
    
    room_data = get_room_data()
    
    if not room_data:
        await query.edit_message_text("❌ ไม่พบข้อมูลห้องพักในระบบ หรือการเชื่อมต่อ Google Sheets มีปัญหา")
        await notify_admin("พบปัญหา: ไม่สามารถดึงข้อมูลห้องพักได้")
        return await send_admin_menu(update, context)

    status_map = {}
    for room in room_data:
        status = room.get('สถานะ', 'ไม่ทราบสถานะ')
        room_num = room.get('หมายเลขห้อง', '??')
        if status not in status_map:
            status_map[status] = []
        status_map[status].append(room_num)

    message = "🏨 **สถานะห้องพักปัจจุบัน** 🏨\n"
    
    vacant_rooms = sorted(status_map.pop('ว่าง', []))
    message += f"🟢 **ห้องว่าง ({len(vacant_rooms)} ห้อง):**\n"
    message += ", ".join(vacant_rooms) if vacant_rooms else "ไม่มี\n"
    
    occupied_rooms = sorted(status_map.pop('ไม่ว่าง', []))
    message += f"\n🔴 **ห้องไม่ว่าง ({len(occupied_rooms)} ห้อง):**\n"
    message += ", ".join(occupied_rooms) if occupied_rooms else "ไม่มี\n"
    
    for status, rooms in status_map.items():
        rooms = sorted(rooms)
        message += f"\n🟡 **{status} ({len(rooms)} ห้อง):**\n"
        message += ", ".join(rooms)
        
    keyboard = [[InlineKeyboardButton("🔙 กลับสู่เมนูหลัก", callback_data='back_to_menu')]]
    await query.edit_message_text(message, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode='Markdown')
    return MENU

