# --- GSPREAD SETUP ---
def setup_gspread():
    """ตั้งค่าการเชื่อมต่อ Google Sheets"""
    global SHEET_DB
    try:
        if not os.path.exists(SERVICE_ACCOUNT_FILE):
            raise FileNotFoundError(f"ไม่พบไฟล์ Service Account Key: '{SERVICE_ACCOUNT_FILE}'")

        creds = Credentials.from_service_account_file(
            SERVICE_ACCOUNT_FILE, scopes=SCOPES)
        client = gspread.authorize(creds)
        SHEET_DB = client.open(SPREADSHEET_NAME)
        logger.info(f"✅ เชื่อมต่อ Google Sheet '{SPREADSHEET_NAME}' สำเร็จ")
        return True
    except FileNotFoundError as e:
        logger.error(f"❌ เกิดข้อผิดพลาดในการเชื่อมต่อ Google Sheet: {e}")
        logger.error(f"โปรดตรวจสอบว่าได้เปลี่ยน SERVICE_ACCOUNT_FILE เป็นชื่อไฟล์ JSON ที่ถูกต้องและไฟล์อยู่ในโฟลเดอร์เดียวกัน (โฟลเดอร์ปัจจุบัน: {os.getcwd()})")
        return False
    except gspread.exceptions.SpreadsheetNotFound:
        logger.error(f"❌ ไม่พบ Google Sheet ชื่อ '{SPREADSHEET_NAME}' ตรวจสอบว่าชื่อถูกต้องและ Service Account มีสิทธิ์เข้าถึง")
        return False
    except gspread.exceptions.APIError as e:
        logger.error(f"❌ เกิดข้อผิดพลาด Google Sheets API: {e}")
        logger.error("ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต, สิทธิ์ของ Service Account (Viewer/Editor) และเปิดใช้งาน Google Sheets API ใน Google Cloud Console.")
        return False
    except Exception as e:
        logger.error(f"❌ เกิดข้อผิดพลาดในการเชื่อมต่อ Google Sheet (อื่นๆ): {e}")
        logger.error("โปรดตรวจสอบการตั้งค่า Service Account, การเข้าถึง Google Sheet และว่าชื่อไฟล์ JSON ถูกต้อง.")
