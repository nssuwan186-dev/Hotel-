    await update.message.reply_text("Debug: บอทอยู่ในโหมด Admin Key. (สถานะนี้ควรถูกข้ามถ้าคุณเป็นเจ้าของ) กรุณาลอง /start เพื่อรีเซ็ต.")
    return MENU # กลับไป MENU เผื่อหลุดมา

async def unhandled_message_fallback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """จับข้อความที่ไม่ถูกจัดการโดย ConversationHandler"""
    logger.warning(f"DEBUG: Unhandled message caught by general fallback from {update.effective_user.id}: '{update.message.text}'")
    await update.message.reply_text("🧐 ไม่เข้าใจคำสั่ง กรุณาเลือกจากเมนู หรือลอง /start หรือ /admin")
    return ConversationHandler.END


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """ตอบกลับด้วยข้อความต้อนรับและเมนูหลักสำหรับผู้ใช้งานทั่วไป"""
    logger.debug(f"DEBUG: start command received from user {update.effective_user.id}")
    # ตรวจสอบว่าผู้ใช้ปัจจุบันคือ Admin หรือไม่
    if update.effective_chat.id == OWNER_CHAT_ID:
        context.user_data['is_admin'] = True
        global ADMIN_CHAT_ID, TELEGRAM_BOT_INSTANCE
        ADMIN_CHAT_ID = update.effective_chat.id 
        TELEGRAM_BOT_INSTANCE = context.bot
        logger.info(f"Owner {update.effective_user.username} (ID: {update.effective_user.id}) recognized and set as Admin.")
        return await send_admin_menu(update, context) # ถ้าเป็น Admin ให้ส่งเมนู Admin ไปเลย

    # ถ้าไม่ใช่ Admin ให้แสดงเมนูเริ่มต้น
    await update.message.reply_text(
        "ยินดีต้อนรับสู่ระบบผู้ช่วยโรงแรมอัตโนมัติ!\n"
        "กรุณาใช้คำสั่ง /admin เพื่อเข้าสู่ระบบจัดการห้องพัก",
        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("เข้าสู่ระบบผู้ดูแล", callback_data='admin')]])
    )
    return MENU


async def admin(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """ตรวจสอบสิทธิ์ Admin โดย Chat ID และแสดงเมนู Admin"""
    user_id = update.effective_chat.id
    username = update.effective_user.username if update.effective_user.username else f"User {user_id}"
    logger.debug(f"DEBUG: admin command received from user {user_id}. Owner_ID: {OWNER_CHAT_ID}")

    if user_id == OWNER_CHAT_ID:
        context.user_data['is_admin'] = True
        global ADMIN_CHAT_ID, TELEGRAM_BOT_INSTANCE
        ADMIN_CHAT_ID = user_id
        TELEGRAM_BOT_INSTANCE = context.bot
        
        message = "✅ เข้าสู่โหมดผู้ดูแลสำเร็จ! ดำเนินการต่อได้เลยครับ"
        
        if update.callback_query:
            await update.callback_query.answer()
            await update.callback_query.edit_message_text(message, parse_mode='Markdown')
        else:
            await update.message.reply_text(message, parse_mode='Markdown')
        
        await notify_admin(f"ผู้ใช้ `{username}` (ID: `{user_id}`) ได้เข้าสู่ระบบ Admin แล้ว.")
        logger.info(f"Admin login successful for owner {username} (ID: {user_id})")
        return await send_admin_menu(update, context) # ส่งเมนู Admin โดยตรง
    else:
        await update.effective_message.reply_text("🚫 คุณไม่มีสิทธิ์เข้าถึงโหมดผู้ดูแลระบบ")
        logger.warning(f"Unauthorized admin access attempt from user {username} (ID: {user_id})")
