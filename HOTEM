# --- Main Function ---
def main() -> None:
    """ฟังก์ชันหลักสำหรับรันบอท"""
    if OWNER_CHAT_ID is None:
        logger.critical("❌ OWNER_CHAT_ID ยังไม่ได้ถูกตั้งค่า! กรุณาใส่ Chat ID ของคุณในโค้ด")
        return
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_BOT_TOKEN.strip():
        logger.critical("❌ ไม่พบ TELEGRAM_BOT_TOKEN กรุณาแก้ไขค่า TELEGRAM_BOT_TOKEN ในโค้ด")
        return
    if not isinstance(TELEGRAM_BOT_TOKEN, str) or len(TELEGRAM_BOT_TOKEN) < 30:
        logger.critical("❌ TELEGRAM_BOT_TOKEN ไม่ถูกต้อง กรุณาตรวจสอบอีกครั้ง")
        return

    if not setup_gspread():
        logger.critical("การตั้งค่า Google Sheet ล้มเหลว โปรดแก้ไขก่อนรันบอท Telegram. บอทจะไม่เริ่มทำงาน.")
        return

    application = Application.builder().token(TELEGRAM_BOT_TOKEN).build()
    
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler("admin", admin))
    application.add_handler(CommandHandler("help", start))

    conv_handler = ConversationHandler(
        entry_points=[CommandHandler("start", start), CommandHandler("admin", admin)],
        states={
            MENU: [
                # เพิ่ม entry_points ของ Conversation Handler ลูกๆ ทั้งหมด
                # เพื่อให้ ConvHandler หลักสามารถ 'เข้าสู่' Conversation ลูกได้จาก MENU
                # CallbackQueryHandler (สำหรับปุ่ม)
                CallbackQueryHandler(handle_menu_choice, pattern='^check_status$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^check_in_start$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^check_out_start$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^pre_booking_start$'), # ปุ่มจัดการจองล่วงหน้า
                CallbackQueryHandler(handle_menu_choice, pattern='^monthly_system_start$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^view_reports$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^logout$'),
                CallbackQueryHandler(handle_menu_choice, pattern='^back_to_menu$'),
                # CommandHandler ที่อยู่ใน MENU state (ถ้ามี)
                CommandHandler("start", start),
                CommandHandler("admin", admin),
                CommandHandler("help", start),

                # --- Conversation Handler ลูกๆ (รวมไว้ใน states[MENU] เลย) ---
                ConversationHandler(
                    entry_points=[CallbackQueryHandler(handle_menu_choice, pattern='^check_in_start$')],
                    states={
                        CHECK_IN_ROOM: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_check_in_room)],
                        CHECK_IN_NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_check_in_name)],
                        CHECK_IN_PHONE: [MessageHandler(filters.TEXT & ~filters.COMMAND, final_check_in_action)],
                    },
                    fallbacks=[CallbackQueryHandler(handle_menu_choice, pattern='^back_to_menu$'), CommandHandler("start", start)],
                    map_to_parent={
                        MENU: MENU
                    }
                ),
                ConversationHandler(
                    entry_points=[CallbackQueryHandler(handle_menu_choice, pattern='^check_out_start$')],
                    states={
                        CHECK_OUT_ROOM: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_check_out_room)],
                    },
                    fallbacks=[CallbackQueryHandler(handle_menu_choice, pattern='^back_to_menu$'), CommandHandler("start", start)],
                    map_to_parent={
                        MENU: MENU
                    }
                ),
                ConversationHandler(
                    entry_points=[CallbackQueryHandler(handle_menu_choice, pattern='^pre_booking_start$')],
                    states={
                        PRE_BOOKING_ROOM: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_pre_booking_room)],
                        PRE_BOOKING_DATE: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_pre_booking_date)],
                        PRE_BOOKING_NIGHTS: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_pre_booking_nights)],
                        PRE_BOOKING_CONFIRM: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_pre_booking_name)],
                        PRE_BOOKING_PHONE: [MessageHandler(filters.TEXT & ~filters.COMMAND, final_pre_booking_action)],
                        PRE_BOOKING_PAYMENT_CONFIRM: [
                            MessageHandler(filters.PHOTO, handle_deposit_photo),
                            CallbackQueryHandler(save_pre_booking_action, pattern='^save_pre_booking$'),
                            CallbackQueryHandler(confirm_deposit_manual_action, pattern='^deposit_confirmed_manual:.*'),
                            MessageHandler(filters.ALL & ~filters.COMMAND, unhandled_message_fallback),
                        ]
                    },
                    fallbacks=[CallbackQueryHandler(handle_menu_choice, pattern='^cancel_pre_booking$|^pre_booking_back$'), CommandHandler("start", start)],
                    map_to_parent={
                        MENU: MENU
                    }
                ),
                ConversationHandler(
                    entry_points=[CallbackQueryHandler(handle_menu_choice, pattern='^add_employee_start$')],
                    states={
                        ADD_EMPLOYEE_NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_employee_name)],
                        ADD_EMPLOYEE_POSITION: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_employee_position)],
                        ADD_EMPLOYEE_SALARY: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_employee_salary)],
                        ADD_EMPLOYEE_DAILY_SALARY: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_employee_daily_salary)],
                        ADD_EMPLOYEE_BANK: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_employee_bank)],
                        VIEW_EMPLOYEE: [MessageHandler(filters.TEXT & ~filters.COMMAND, confirm_add_employee)],
                    },
                    fallbacks=[CallbackQueryHandler(handle_menu_choice, pattern='^cancel_add_employee$|^employee_menu_back$'), CommandHandler("start", start)],
                    map_to_parent={
                        MENU: MENU # <--- แก้ไขตรงนี้ให้กลับไปที่ MENU หลัก
                    }
                ),
                ConversationHandler(
                    entry_points=[CallbackQueryHandler(handle_menu_choice, pattern='^issue_invoice_start$')],
                    states={
                        ISSUE_INVOICE_ROOM: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_invoice_room)],
                        ISSUE_INVOICE_DETAILS: [MessageHandler(filters.TEXT & ~filters.COMMAND, get_invoice_details_and_confirm)],
                    },
                    fallbacks=[CallbackQueryHandler(handle_menu_choice, pattern='^rent_menu_back$'), CommandHandler("start", start)],
                    map_to_parent={
                        MENU: MENU # <--- แก้ไขตรงนี้ให้กลับไปที่ MENU หลัก
                    }
                ),
                # --- สิ้นสุด Conversation Handler ลูกๆ ---
            ],
            # สถานะอื่นๆ ที่เป็นส่วนหนึ่งของ ConvHandler หลัก (นอกเหนือจาก MENU)
            MONTHLY_MENU: [CallbackQueryHandler(handle_menu_choice)], # Catch-all สำหรับปุ่มใน Monthly Menu
            EMPLOYEE_MENU: [CallbackQueryHandler(handle_menu_choice)], # Catch-all สำหรับปุ่มใน Employee Menu
            RENT_MENU: [CallbackQueryHandler(handle_menu_choice)], # Catch-all สำหรับปุ่มใน Rent Menu
            # เพิ่ม MessageHandler ในแต่ละ State เพื่อการ Debug (หาก CallbackQueryHandler ไม่ทำงาน)
            PRE_BOOKING_CONFIRM: [CallbackQueryHandler(handle_menu_choice)], # สำหรับ CallbackQuery ที่ไม่ได้ถูกจับ
            PRE_BOOKING_PHONE: [CallbackQueryHandler(handle_menu_choice)], # สำหรับ CallbackQuery ที่ไม่ได้ถูกจับ
            PRE_BOOKING_PAYMENT_CONFIRM: [CallbackQueryHandler(handle_menu_choice)], # สำหรับ CallbackQuery ที่ไม่ได้ถูกจับ
        },
        fallbacks=[CommandHandler("start", start), CallbackQueryHandler(handle_menu_choice, pattern='^logout$')],
    )

    application.add_handler(conv_handler)
    
    application.add_handler(MessageHandler(filters.ALL, unhandled_message_fallback))

    logger.info("บอทเริ่มต้นทำงาน...")
    application.run_polling(allowed_updates=Update.ALL_TYPES)
    
if __name__ == '__main__':
    main()
