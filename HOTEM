async def debug_admin_auth_catch_all(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """ฟังก์ชัน Debug สำหรับ MessageHandler catch-all ใน ADMIN_AUTH (ยังคงเก็บไว้เป็น fallback)"""
