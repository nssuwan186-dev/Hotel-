def update_pre_booking_status(booking_id, new_status, deposit_slip_link='-'):
    sheet = get_worksheet("การเข้าพัก")
    if not sheet: return False

    try:
        cell = sheet.find(str(booking_id), in_column=1)
        if not cell:
            logger.warning(f"ไม่พบ Booking ID {booking_id} ในชีต 'การเข้าพัก' สำหรับการอัพเดทสถานะ")
            return False
        
        headers = sheet.row_values(1)
        try:
            status_col_index = headers.index('สถานะ') + 1
            slip_col_index = headers.index('สลิปมัดจำ(ลิงก์)') + 1
        except ValueError as ve:
            logger.error(f"ไม่พบหัวข้อคอลัมน์ที่จำเป็นในชีต 'การเข้าพัก': {ve}")
            return False

        sheet.update_cell(cell.row, status_col_index, new_status)
        if deposit_slip_link != '-':
            sheet.update_cell(cell.row, slip_col_index, deposit_slip_link)
        logger.info(f"อัพเดทสถานะการจอง '{booking_id}' เป็น '{new_status}' สำเร็จ")
        return True
    except Exception as e:
        logger.error(f"ไม่สามารถอัพเดทสถานะการจอง {booking_id}: {e}")
        return False

def check_room_availability_for_dates(room_number: str, check_in_date: datetime, check_out_date: datetime):
    """
    ตรวจสอบว่าห้องว่างในช่วงวันที่ที่ระบุหรือไม่ โดยตรวจสอบจากการจองที่มีอยู่ในชีต 'การเข้าพัก'
    :param room_number: หมายเลขห้อง
    :param check_in_date: วันที่เข้าพัก (datetime object)
    :param check_out_date: วันที่เช็คเอาท์ (datetime object)
    :return: True ถ้าห้องว่างในช่วงวันที่นั้น, False ถ้ามีช่วงเวลาทับซ้อน
    """
    sheet = get_worksheet("การเข้าพัก")
    if not sheet:
        logger.error(f"ไม่สามารถตรวจสอบห้องว่างได้: ไม่พบชีต 'การเข้าพัก'")
        return False

    try:
        records = sheet.get_all_records()
        
        relevant_bookings = [
            r for r in records 
            if r.get('ห้อง') == room_number and 
               r.get('สถานะ') in ['ไม่ว่าง', 'จองล่วงหน้า', 'ชำระมัดจำแล้ว (ด้วยมือ)', 'ชำระมัดจำแล้ว (มีสลิป)']
        ]

        for booking in relevant_bookings:
            try:
                existing_check_in_str = booking.get('เช็คอิน', '').split(' ')[0]
                existing_check_out_str = booking.get('เช็คเอาท์', '').split(' ')[0]

                existing_check_in_dt = datetime.strptime(existing_check_in_str, "%Y-%m-%d")
                existing_check_out_dt = datetime.strptime(existing_check_out_str, "%Y-%m-%d")
                
                if (check_in_date < existing_check_out_dt) and \
                   (check_out_date > existing_check_in_dt):
                    logger.warning(f"ห้อง {room_number} มีการจองทับซ้อน: Booking ID {booking.get('booking_id')}, ช่วง {existing_check_in_str} ถึง {existing_check_out_str}")
                    return False
            except (ValueError, TypeError) as e:
                logger.error(f"ข้อผิดพลาดในการแปลงวันที่ของการจอง ID {booking.get('booking_id')}: {e}")
                continue

    except Exception as e:
        logger.error(f"เกิดข้อผิดพลาดในการดึงข้อมูลการจองจากชีต 'การเข้าพัก': {e}")
        return False

    return True

