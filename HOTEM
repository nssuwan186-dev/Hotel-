def get_worksheet(sheet_name):
    """ดึง Worksheet ตามชื่อ"""
    global SHEET_DB
    if not SHEET_DB:
        logger.warning(f"SHEET_DB ยังไม่ได้เชื่อมต่อ ลองตั้งค่าใหม่...")
        if not setup_gspread():
            logger.error("ไม่สามารถเชื่อมต่อ Google Sheets ได้หลังจากพยายามตั้งค่าใหม่")
            return None
    if not SHEET_DB:
        logger.error(f"SHEET_DB ยังคงเป็น None หลังพยายามตั้งค่า. ไม่สามารถดึง Worksheet '{sheet_name}' ได้")
        return None
        
    try:
        ws = SHEET_DB.worksheet(sheet_name)
        return ws
    except gspread.WorksheetNotFound:
        logger.error(f"ไม่พบ Worksheet ชื่อ '{sheet_name}' ใน Google Sheet '{SPREADSHEET_NAME}'")
        return None
    except Exception as e:
        logger.error(f"เกิดข้อผิดพลาดในการดึง Worksheet '{sheet_name}': {e}")
        return None

def get_room_data(room_number=None):
    """ดึงข้อมูลห้องพักทั้งหมด หรือเฉพาะห้องที่ระบุจาก 'ข้อมูลห้องพัก'"""
    sheet = get_worksheet("ข้อมูลห้องพัก")
    if not sheet:
        return []
    
    try:
        data = sheet.get_all_records()
    except Exception as e:
        logger.error(f"เกิดข้อผิดพลาดในการดึงข้อมูลจากชีต 'ข้อมูลห้องพัก': {e}")
        return []

    if room_number:
        for room in data:
            if room.get('หมายเลขห้อง') and str(room['หมายเลขห้อง']).upper() == room_number.upper():
                return room
        return None 
    
    return data

def update_room_status(room_number, new_status):
    """อัพเดทสถานะห้องพักในชีต 'ข้อมูลห้องพัก'"""
    sheet = get_worksheet("ข้อมูลห้องพัก")
    if not sheet: return False

    try:
        cell = sheet.find(room_number, in_column=1)
        if not cell:
            logger.warning(f"ไม่พบห้อง {room_number} ในชีต 'ข้อมูลห้องพัก' สำหรับการอัพเดทสถานะ")
            return False
            
        headers = sheet.row_values(1)
        try:
            status_col_index = headers.index('สถานะ') + 1
        except ValueError:
            logger.error(f"ไม่พบหัวข้อ 'สถานะ' ในชีต 'ข้อมูลห้องพัก'")
            return False
        
        sheet.update_cell(cell.row, status_col_index, new_status)
        logger.info(f"อัพเดทสถานะห้อง {room_number} เป็น {new_status} สำเร็จ")
        return True
    except Exception as e:
        logger.error(f"ไม่สามารถอัพเดทสถานะห้องพัก {room_number}: {e}")
        return False

def add_employee_record(data):
    """บันทึกข้อมูลพนักงานใหม่ลงในชีต 'ข้อมูลพนักงาน'"""
    sheet = get_worksheet("ข้อมูลพนักงาน")
    if not sheet: return False
    
    try:
        headers = sheet.row_values(1)
        if not headers or len(headers) < 2:
            logger.error("ชีต 'ข้อมูลพนักงาน' ไม่มีหัวข้อคอลัมน์ที่ถูกต้อง")
            return False
        
        last_row_index = len(sheet.get_all_values())
        data['emp_id'] = f"EMP{last_row_index}" 
        data['วันที่สร้าง'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        row_data = [data.get(h, '-') for h in headers]
        
        sheet.append_row(row_data)
        logger.info(f"บันทึกข้อมูลพนักงาน {data.get('ชื่อ-สกุล')} สำเร็จ (ID: {data['emp_id']})")
        return data['emp_id']
    except Exception as e:
        logger.error(f"ไม่สามารถบันทึกข้อมูลพนักงาน: {e}")
        return False

def add_stay_record(data, is_pre_booking=False):
    """บันทึกข้อมูลการเข้าพัก/จองล่วงหน้าลงในชีต 'การเข้าพัก'"""
    sheet = get_worksheet("การเข้าพัก")
    if not sheet: return False

    try:
        headers = sheet.row_values(1)
        if not headers or len(headers) < 5:
            logger.error("ชีต 'การเข้าพัก' ไม่มีหัวข้อคอลัมน์ที่ถูกต้อง")
            return False

        data['booking_id'] = f"{'PRE' if is_pre_booking else 'STAY'}{uuid.uuid4().hex[:6].upper()}"
        data['guest_id'] = data.get('guest_id', f"GUEST_{uuid.uuid4().hex[:4].upper()}")
        data['วันที่สร้าง'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        default_data = {
            "เช็คอิน": data.get("วันที่เข้าพัก", datetime.now().strftime("%Y-%m-%d 14:00:00")),
            "เช็คเอาท์": data.get("วันที่ออก", '-'),
            "จำนวนคืน": data.get("จำนวนคืน", 1),
            "ราคาต่อคืน": data.get("ราคาต่อคืน", 400),
            "ยอดรวม": data.get("ยอดรวม", data.get("ราคาต่อคืน", 400)),
            "วิธีชำระเงิน": data.get("วิธีชำระเงิน", 'เงินสด'),
            "จำนวนผู้เข้าพัก": data.get("จำนวนผู้เข้าพัก", 1),
            "สถานะ": data.get("สถานะ", 'ไม่ว่าง' if not is_pre_booking else 'จองล่วงหน้า'),
            "สลิปมัดจำ(ลิงก์)": data.get("สลิปมัดจำ(ลิงก์)", '-'),
        }
        
        final_data = {**default_data, **data}
        row_data = [final_data.get(h, '-') for h in headers]
        
        sheet.append_row(row_data)
        logger.info(f"บันทึกการเข้าพัก/จองล่วงหน้า '{final_data['booking_id']}' สำเร็จ")
        return final_data['booking_id']
    except Exception as e:
        logger.error(f"ไม่สามารถบันทึกข้อมูลการเข้าพัก/จองล่วงหน้า: {e}")
        return False

