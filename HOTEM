    return PRE_BOOKING_DATE

async def get_pre_booking_date(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """รับวันที่เข้าพัก และขอจำนวนคืน"""
    logger.debug(f"DEBUG: get_pre_booking_date called with text: '{update.message.text}' from user {update.effective_user.id}")
    booking_date_str = update.message.text.strip()
    try:
        booking_date = datetime.strptime(booking_date_str, "%Y-%m-%d")
        if booking_date < datetime.now().replace(hour=0, minute=0, second=0, microsecond=0):
            await update.message.reply_text("❌ วันที่เข้าพักต้องเป็นวันปัจจุบันหรือในอนาคต กรุณาพิมพ์วันที่ใหม่อีกครั้ง (YYYY-MM-DD):")
            return PRE_BOOKING_DATE
        context.user_data['pre_booking_data']['วันที่เข้าพัก'] = booking_date_str
    except ValueError:
        await update.message.reply_text("❌ รูปแบบวันที่ไม่ถูกต้อง กรุณาใช้รูปแบบ YYYY-MM-DD (เช่น 2025-12-25):")
        return PRE_BOOKING_DATE
    
    await update.message.reply_text("3. กรุณาพิมพ์ **จำนวนคืน** ที่เข้าพัก:")
    return PRE_BOOKING_NIGHTS

async def get_pre_booking_nights(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """รับจำนวนคืน, ตรวจสอบการทับซ้อนของวันที่ และขอชื่อแขก"""
    logger.debug(f"DEBUG: get_pre_booking_nights called with text: '{update.message.text}' from user {update.effective_user.id}")
    try:
        nights = int(update.message.text.strip())
        if nights <= 0:
            raise ValueError
        context.user_data['pre_booking_data']['จำนวนคืน'] = nights
        
        check_in_date_str = context.user_data['pre_booking_data']['วันที่เข้าพัก']
        check_in_date_dt = datetime.strptime(check_in_date_str, "%Y-%m-%d")
        check_out_date_dt = check_in_date_dt + timedelta(days=nights)
        context.user_data['pre_booking_data']['วันที่ออก'] = check_out_date_dt.strftime("%Y-%m-%d %H:%M:%S")

        room_number = context.user_data['pre_booking_data']['ห้อง']

        # ตรวจสอบช่วงวันว่างของห้องพัก
        is_available = check_room_availability_for_dates(room_number, check_in_date_dt, check_out_date_dt)
        if not is_available:
            await update.message.reply_text(
                f"❌ ห้อง **{room_number}** ไม่ว่างในช่วงวันที่ **{check_in_date_str}** ถึง **{check_out_date_dt.strftime('%Y-%m-%d')}** "
                f"เนื่องจากมีการจองอื่นทับซ้อนอยู่ กรุณาเลือกห้องหรือวันที่อื่น:"
            )
            return PRE_BOOKING_ROOM # กลับไปขอหมายเลขห้องใหม่ (หรือจะกลับไปขอวันใหม่ก็ได้)

        room_price_per_night = float(context.user_data['pre_booking_data'].get('ราคาต่อคืน', 0))
        total_amount = room_price_per_night * nights
        context.user_data['pre_booking_data']['ยอดรวม'] = total_amount
        context.user_data['pre_booking_data']['สถานะ'] = 'จองล่วงหน้า'

    except ValueError:
        await update.message.reply_text("❌ จำนวนคืนไม่ถูกต้อง กรุณาใส่เป็นตัวเลขจำนวนเต็มบวก:")
        return PRE_BOOKING_NIGHTS
    
    await update.message.reply_text("4. กรุณาพิมพ์ **ชื่อ-นามสกุล** ผู้จอง:")
    return PRE_BOOKING_CONFIRM

